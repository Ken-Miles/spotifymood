# Discord bot + Discord sign-in
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MOOD_CHANNEL_ID=

# Spotify sign-in (developer.spotify.com dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm sign-in (last.fm/api/account/create)
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Public address your friend opens, e.g. https://mood.example.com
# (http://localhost:3000 works only on this machine)
PUBLIC_BASE_URL=https://bbb.jmulligan191.com
PORT=3000

# Comma-separated Discord user IDs allowed to sign in and be tracked
ALLOWED_DISCORD_IDS=

# Random secrets. Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Optional: LLM fallback for songs with no mood tags
ANTHROPIC_API_KEY=

# Optional: defaults to data/mood.db
SQLITE_PATH=

# Discord user ID allowed to run the "owneronly" text command (re-syncs slash commands)
OWNER_DISCORD_ID=
